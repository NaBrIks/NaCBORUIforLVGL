{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lvgl-cbor: экран, черновик 1",
  "description": "Формат браузерного редактора; не wire-контракт существующей прошивки.",
  "type": "object",
  "required": [
    "format",
    "id",
    "name",
    "size",
    "root"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "lvgl-screen-draft-1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "theme": {
      "enum": [
        "device",
        "none"
      ]
    },
    "bindings": {
      "type": "array",
      "maxItems": 0
    },
    "size": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        }
      },
      "additionalProperties": false
    },
    "styles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "props"
        ],
        "properties": {
          "props": {
            "$ref": "#/$defs/style"
          }
        },
        "additionalProperties": false
      }
    },
    "root": {
      "$ref": "#/$defs/node"
    }
  },
  "$defs": {
    "dimension": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "const": "content"
        },
        {
          "type": "object",
          "required": [
            "pct"
          ],
          "properties": {
            "pct": {
              "type": "integer",
              "minimum": -10000,
              "maximum": 10000
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "track": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 32767
        },
        {
          "const": "content"
        },
        {
          "type": "object",
          "required": [
            "fr"
          ],
          "properties": {
            "fr": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "style": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "align",
          "anim",
          "anim_duration",
          "arc_color",
          "arc_image_src",
          "arc_opa",
          "arc_rounded",
          "arc_width",
          "base_dir",
          "bg_color",
          "bg_grad",
          "bg_grad_color",
          "bg_grad_dir",
          "bg_grad_opa",
          "bg_grad_stop",
          "bg_image_opa",
          "bg_image_recolor",
          "bg_image_recolor_opa",
          "bg_image_src",
          "bg_image_tiled",
          "bg_main_opa",
          "bg_main_stop",
          "bg_opa",
          "bitmap_mask_src",
          "blend_mode",
          "blur_backdrop",
          "blur_quality",
          "blur_radius",
          "border_color",
          "border_opa",
          "border_post",
          "border_side",
          "border_width",
          "clip_corner",
          "color_filter_dsc",
          "color_filter_opa",
          "drop_shadow_color",
          "drop_shadow_offset_x",
          "drop_shadow_offset_y",
          "drop_shadow_opa",
          "drop_shadow_quality",
          "drop_shadow_radius",
          "flex_cross_place",
          "flex_flow",
          "flex_grow",
          "flex_main_place",
          "flex_track_place",
          "grid_cell_column_pos",
          "grid_cell_column_span",
          "grid_cell_row_pos",
          "grid_cell_row_span",
          "grid_cell_x_align",
          "grid_cell_y_align",
          "grid_column_align",
          "grid_column_dsc_array",
          "grid_row_align",
          "grid_row_dsc_array",
          "height",
          "image_colorkey",
          "image_opa",
          "image_recolor",
          "image_recolor_opa",
          "layout",
          "length",
          "line_color",
          "line_dash_gap",
          "line_dash_width",
          "line_opa",
          "line_rounded",
          "line_width",
          "margin_all",
          "margin_bottom",
          "margin_hor",
          "margin_left",
          "margin_right",
          "margin_top",
          "margin_ver",
          "max_height",
          "max_width",
          "min_height",
          "min_width",
          "opa",
          "opa_layered",
          "outline_color",
          "outline_opa",
          "outline_pad",
          "outline_width",
          "pad_all",
          "pad_bottom",
          "pad_column",
          "pad_gap",
          "pad_hor",
          "pad_left",
          "pad_radial",
          "pad_right",
          "pad_row",
          "pad_top",
          "pad_ver",
          "radial_offset",
          "radius",
          "recolor",
          "recolor_opa",
          "rotary_sensitivity",
          "shadow_color",
          "shadow_offset_x",
          "shadow_offset_y",
          "shadow_opa",
          "shadow_spread",
          "shadow_width",
          "text_align",
          "text_color",
          "text_decor",
          "text_font",
          "text_leading_trim",
          "text_letter_space",
          "text_line_space",
          "text_opa",
          "text_outline_stroke_color",
          "text_outline_stroke_opa",
          "text_outline_stroke_width",
          "transform_height",
          "transform_pivot_x",
          "transform_pivot_y",
          "transform_rotation",
          "transform_scale",
          "transform_scale_x",
          "transform_scale_y",
          "transform_skew_x",
          "transform_skew_y",
          "transform_width",
          "transition",
          "translate_radial",
          "translate_x",
          "translate_y",
          "width",
          "x",
          "y"
        ]
      },
      "additionalProperties": {
        "type": [
          "number",
          "string",
          "boolean"
        ]
      },
      "properties": {
        "width": {
          "$ref": "#/$defs/dimension"
        },
        "height": {
          "$ref": "#/$defs/dimension"
        },
        "min_width": {
          "$ref": "#/$defs/dimension"
        },
        "min_height": {
          "$ref": "#/$defs/dimension"
        },
        "max_width": {
          "$ref": "#/$defs/dimension"
        },
        "max_height": {
          "$ref": "#/$defs/dimension"
        },
        "x": {
          "$ref": "#/$defs/dimension"
        },
        "y": {
          "$ref": "#/$defs/dimension"
        },
        "grid_column_dsc_array": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/track"
          }
        },
        "grid_row_dsc_array": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/track"
          }
        }
      }
    },
    "styleRule": {
      "type": "object",
      "required": [
        "props"
      ],
      "properties": {
        "part": {
          "type": "string",
          "default": "MAIN"
        },
        "state": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "props": {
          "$ref": "#/$defs/style"
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "obj",
            "label",
            "button",
            "bar",
            "slider",
            "arc",
            "line",
            "image",
            "checkbox",
            "switch",
            "textarea",
            "dropdown"
          ]
        },
        "bindings": {
          "type": "array",
          "maxItems": 0
        },
        "common": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "add_flags",
              "remove_flags",
              "add_state",
              "remove_state",
              "scrollbar_mode",
              "scroll_dir"
            ]
          },
          "additionalProperties": {
            "type": [
              "integer",
              "boolean",
              "string",
              "array"
            ]
          }
        },
        "props": {
          "type": "object",
          "description": "Параметры конкретного виджета; подробнее в readme_screen_model.ru.md",
          "properties": {
            "text": {
              "type": "string"
            },
            "src": {
              "type": "string"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "value": {
              "type": "number"
            },
            "checked": {
              "type": "boolean"
            },
            "one_line": {
              "type": "boolean"
            },
            "password_mode": {
              "type": "boolean"
            },
            "max_length": {
              "type": "integer",
              "minimum": 0
            },
            "max_lines": {
              "type": "integer",
              "minimum": 0
            },
            "long_mode": {
              "type": "integer"
            },
            "start_value": {
              "type": "integer"
            },
            "scale": {
              "type": "integer"
            },
            "rotation": {
              "type": "integer"
            },
            "mode": {
              "type": "integer"
            },
            "direction": {
              "type": "integer"
            },
            "angles": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "bg_angles": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "options": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "selected": {
              "type": "integer",
              "minimum": 0
            },
            "points": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "additionalProperties": false
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "styles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ref"
            ],
            "properties": {
              "ref": {
                "type": "string"
              },
              "part": {
                "type": "string",
                "default": "MAIN"
              },
              "state": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "styleRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/styleRule"
          }
        },
        "flags": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "maxItems": 128
        }
      }
    }
  }
}
