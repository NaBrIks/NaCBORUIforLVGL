{
  "format": "lvgl-project-1",
  "manifest": {
    "id": "windows-demo",
    "name": "Windows LVGL demo",
    "entry": "shell"
  },
  "screens": {
    "shell": {
      "format": "lvgl-screen-draft-1",
      "id": "shell",
      "name": "Windows LVGL demo",
      "size": {
        "width": 800,
        "height": 480
      },
      "styles": {},
      "root": {
        "id": "root",
        "type": "obj",
        "props": {},
        "style": {
          "bg_opa": 255,
          "pad_all": 0,
          "border_width": 0,
          "text_font": "montserrat_20"
        },
        "children": [
          {
            "id": "status",
            "type": "obj",
            "props": {},
            "style": {
              "x": 0,
              "y": 0,
              "width": 800,
              "height": 28,
              "pad_all": 0,
              "border_width": 0,
              "radius": 0
            },
            "children": [
              {
                "id": "platform",
                "type": "label",
                "props": {
                  "text": "Windows / LVGL 9.6 - autonomous demo"
                },
                "style": {
                  "x": 8,
                  "y": 2
                },
                "children": []
              },
              {
                "id": "clock",
                "type": "label",
                "props": {
                  "text": "--:--:--"
                },
                "style": {
                  "x": 690,
                  "y": 2
                },
                "children": [],
                "bindings": [
                  {
                    "method": "text",
                    "value": {
                      "source": "system.clock",
                      "path": [
                        "localTime"
                      ]
                    }
                  }
                ]
              }
            ],
            "styles": [
              {
                "ref": "global-static:ui.status",
                "part": "MAIN",
                "state": []
              }
            ]
          },
          {
            "id": "content",
            "type": "obj",
            "props": {},
            "style": {
              "x": 0,
              "y": 28,
              "width": 800,
              "height": 408,
              "pad_all": 0,
              "border_width": 0,
              "radius": 0
            },
            "children": [],
            "flags": {
              "SCROLLABLE": false
            },
            "view": {
              "pages": [
                {
                  "screen": "overview",
                  "retention": "retain"
                },
                {
                  "screen": "details",
                  "retention": "cache"
                }
              ],
              "initial": "overview",
              "sizing": "fill"
            },
            "styles": [
              {
                "ref": "global-static:ui.canvas",
                "part": "MAIN",
                "state": []
              }
            ]
          },
          {
            "id": "go_overview",
            "type": "button",
            "props": {
              "text": "Overview"
            },
            "style": {
              "x": 0,
              "y": 436,
              "width": 400,
              "height": 44
            },
            "children": [],
            "events": [
              {
                "event": "clicked",
                "navigate": {
                  "view": "content",
                  "screen": "overview"
                }
              }
            ],
            "styles": [
              {
                "ref": "global-static:ui.button",
                "part": "MAIN",
                "state": []
              },
              {
                "ref": "global-static:ui.button_pressed",
                "part": "MAIN",
                "state": [
                  "PRESSED"
                ]
              },
              {
                "ref": "global-static:ui.button_focus",
                "part": "MAIN",
                "state": [
                  "FOCUSED"
                ]
              },
              {
                "ref": "global-static:ui.button_disabled",
                "part": "MAIN",
                "state": [
                  "DISABLED"
                ]
              }
            ]
          },
          {
            "id": "go_details",
            "type": "button",
            "props": {
              "text": "Details"
            },
            "style": {
              "x": 400,
              "y": 436,
              "width": 400,
              "height": 44
            },
            "children": [],
            "events": [
              {
                "event": "clicked",
                "navigate": {
                  "view": "content",
                  "screen": "details"
                }
              }
            ],
            "styles": [
              {
                "ref": "global-static:ui.button",
                "part": "MAIN",
                "state": []
              },
              {
                "ref": "global-static:ui.button_pressed",
                "part": "MAIN",
                "state": [
                  "PRESSED"
                ]
              },
              {
                "ref": "global-static:ui.button_focus",
                "part": "MAIN",
                "state": [
                  "FOCUSED"
                ]
              },
              {
                "ref": "global-static:ui.button_disabled",
                "part": "MAIN",
                "state": [
                  "DISABLED"
                ]
              }
            ]
          }
