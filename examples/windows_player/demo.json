        "flags": {
          "SCROLLABLE": false
        },
        "styles": [
          {
            "ref": "global-static:ui.canvas",
            "part": "MAIN",
            "state": []
          }
        ]
      }
    },
    "overview": {
      "format": "lvgl-screen-draft-1",
      "id": "overview",
      "name": "Overview",
      "size": {
        "width": 800,
        "height": 408
      },
      "styles": {},
      "root": {
        "id": "root",
        "type": "obj",
        "props": {},
        "style": {
          "bg_opa": 255,
          "pad_all": 0,
          "border_width": 0,
          "text_font": "montserrat_20"
        },
        "children": [
          {
            "id": "speed_arc",
            "type": "arc",
            "props": {
              "min": 0,
              "max": 180,
              "value": 0
            },
            "style": {
              "x": 22,
              "y": 24,
              "width": 280,
              "height": 280
            },
            "children": [],
            "flags": {
              "CLICKABLE": false
            },
            "bindings": [
              {
                "method": "value",
                "value": {
                  "op": "round",
                  "args": [
                    {
                      "source": "demo.speed",
                      "path": [
                        "kmh"
                      ]
                    }
                  ]
                }
              }
            ],
            "styles": [
              {
                "ref": "global-static:ui.arc_track",
                "part": "MAIN",
                "state": []
              },
              {
                "ref": "global-static:ui.arc_value",
                "part": "INDICATOR",
                "state": []
              },
              {
                "ref": "global-static:ui.indicator",
                "part": "KNOB",
                "state": []
              }
            ]
          },
          {
            "id": "speed",
            "type": "label",
            "props": {
              "text": "-- km/h"
            },
            "style": {
              "x": 340,
              "y": 40
            },
            "children": [],
            "bindings": [
              {
                "method": "text",
                "value": {
                  "source": "demo.speed",
                  "path": [
                    "kmh"
                  ]
                },
                "format": {
                  "precision": 1,
                  "suffix": " km/h"
                }
              }
            ]
          },
          {
            "id": "counter",
            "type": "label",
            "props": {
              "text": "Actions: 0"
            },
            "style": {
              "x": 340,
              "y": 92
            },
            "children": [],
            "bindings": [
              {
                "method": "text",
                "value": {
                  "source": "demo.clicks"
                },
                "format": {
                  "prefix": "Actions: "
                }
              }
            ]
          },
          {
            "id": "running_title",
            "type": "label",
            "props": {
              "text": "Run generator"
            },
            "style": {
              "x": 340,
              "y": 150
            },
            "children": []
          },
          {
            "id": "running",
            "type": "switch",
            "props": {
              "checked": true
            },
            "style": {
              "x": 570,
              "y": 144,
              "width": 70,
              "height": 36
            },
            "children": [],
            "bindings": [
              {
                "scope": "common",
                "method": "state",
                "value": [
                  {
                    "literal": 4
                  },
                  {
                    "source": "demo.running"
                  }
                ]
              }
            ],
            "events": [
              {
                "event": "value_changed",
                "write": {
                  "source": "demo.running"
                },
                "value": {
                  "event": "value"
                }
              }
            ],
            "styles": [
              {
                "ref": "global-static:ui.track",
                "part": "MAIN",
                "state": []
              },
              {
                "ref": "global-static:ui.indicator",
                "part": "INDICATOR",
                "state": []
              },
              {
                "ref": "global-static:ui.knob",
                "part": "KNOB",
                "state": []
              }
            ]
          },
          {
            "id": "step",
            "type": "button",
            "props": {
              "text": "Add 1"
