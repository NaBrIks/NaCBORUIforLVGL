{
  "format": "lvgl-screen-draft-1",
  "id": "shared",
  "name": "MVP · общие стили и состояния",
  "theme": "none",
  "size": {
    "width": 800,
    "height": 480
  },
  "styles": {
    "button": {
      "props": {
        "bg_color": "#246e8c",
        "bg_opa": 255,
        "text_color": "#ffffff",
        "radius": 8,
        "border_width": 2,
        "border_color": "#3dbb91"
      }
    }
  },
  "root": {
    "id": "root",
    "type": "obj",
    "style": {
      "bg_color": "#101820",
      "bg_opa": 255,
      "layout": "LV_LAYOUT_FLEX",
      "flex_flow": "LV_FLEX_FLOW_COLUMN",
      "pad_all": 20,
      "pad_row": 16
    },
    "props": {},
    "flags": {
      "SCROLLABLE": false
    },
    "children": [
      {
        "id": "title",
        "type": "label",
        "style": {
          "text_color": "#ffffff",
          "text_font": "montserrat_28"
        },
        "props": {
          "text": "Shared styles / part / state"
        },
        "flags": {
          "SCROLLABLE": false
        },
        "children": []
      },
      {
        "id": "button_a",
        "type": "button",
        "style": {
          "width": 240,
          "height": 60
        },
        "props": {
          "text": "First"
        },
        "flags": {
          "SCROLLABLE": false
        },
        "children": [],
        "styles": [
          {
            "ref": "screen:button"
          }
        ],
        "styleRules": [
          {
            "state": [
              "PRESSED"
            ],
            "props": {
              "bg_color": "#d48522"
            }
          }
        ]
      },
      {
        "id": "button_b",
        "type": "button",
        "style": {
          "width": 240,
          "height": 60
        },
        "props": {
          "text": "Second"
        },
        "flags": {
          "SCROLLABLE": false
        },
        "children": [],
        "styles": [
          {
            "ref": "screen:button"
          }
        ]
      },
      {
        "id": "checked",
        "type": "checkbox",
        "style": {
          "text_color": "#ffffff"
        },
        "props": {
          "text": "Checked state",
          "checked": true
        },
        "flags": {
          "SCROLLABLE": false
        },
        "children": [],
        "styleRules": [
          {
            "part": "INDICATOR",
            "state": [
              "CHECKED"
            ],
            "props": {
              "bg_color": "#3dbb91",
              "bg_opa": 255,
              "width": 20,
              "height": 20
            }
          }
        ]
      }
    ]
  },
  "bindings": []
}
