@page "/"
@using NaCBORUI.Designer.Core
@implements IAsyncDisposable
@inject DesignerSessionAdapter Session
@inject IJSRuntime JS
@inject UiText T

<PageTitle>NaCBORUIforLVGL</PageTitle>

<div class="app-root @(DarkTheme ? "theme-dark" : string.Empty)" lang="@T.Language">
<div class="designer-shell">
    <header class="topbar">
        <div class="brand"><span class="brand-mark" aria-hidden="true">N</span><span>NaCBORUIforLVGL</span></div>
        <div class="connection-controls">
            <select class="active-connection-chooser" aria-label="@T["Подключение"]"
                    title="@(Session.Settings.SelectedConnection is { } profile ? ActiveConnectionTitle(profile) : T["Подключение"])"
                    disabled="@(ConnectionLocked || Session.Settings.Connections.Count == 0)"
                    @bind:get="Session.Settings.SelectedConnectionId" @bind:set="SelectActiveConnection">
                @foreach (var item in Session.Settings.Connections)
                {
                    <option @key="item.Id" value="@item.Id" title="@ActiveConnectionTitle(item)">@item.Name</option>
                }
            </select>
            <button class="button secondary connection-button @(Session.IsConnected && !Connecting ? "connected" : null)"
                    type="button" title="@ConnectionTooltip" aria-label="@ConnectionTooltip" aria-busy="@(Connecting ? "true" : "false")"
                    disabled="@(ConnectionLocked || Session.Settings.Connections.Count == 0)" @onclick="Connect">
                <span class="status-dot" aria-hidden="true"></span><span>@ConnectionLabel</span>
            </button>
        </div>
        <div class="top-actions">
            <button class="icon-button theme-button" type="button" title="@T["Сменить тему"]" aria-label="@T["Сменить тему"]" @onclick="ToggleTheme">@(DarkTheme ? "☼" : "◐")</button>
            <button class="icon-button settings-button" type="button" title="@T["Настройки"]" aria-label="@T["Настройки"]"
                    disabled="@Session.IsBusy" @onclick="OpenSettings">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M10 2h4l.5 2.5 1.8.8 2.2-1.4 2.8 2.8-1.4 2.2.8 1.8 2.3.5v4l-2.3.5-.8 1.8 1.4 2.2-2.8 2.8-2.2-1.4-1.8.8L14 24h-4l-.5-2.1-1.8-.8-2.2 1.4-2.8-2.8 1.4-2.2-.8-1.8L1 15.2v-4l2.3-.5.8-1.8-1.4-2.2 2.8-2.8 2.2 1.4 1.8-.8Z" transform="translate(1 0) scale(.92)"/>
                    <circle cx="12" cy="12" r="3"/>
                </svg>
            </button>
        </div>
    </header>

    <main class="work-area" @ref="WorkAreaElement" style="@PaneStyle">
        <section class="chat-pane" aria-label="@T["Чат конструктора"]">
            <div class="chat-heading">
                <div><h1>@T["Конструктор интерфейса"]</h1><span class="subheading">@T["Чат и проверка через общий LVGL runtime"]</span></div>
                <div class="chat-actions">
                    <div class="mode-switch" role="group" aria-label="@T["Режим ответа"]">
                        <button class="@(!Session.ShowReasoning ? "selected" : "")" @onclick="() => SetMode(false)">@T["Обычный"]</button>
                        <button class="@(Session.ShowReasoning ? "selected" : "")" @onclick="() => SetMode(true)">@T["Подробный"]</button>
                    </div>
                    <button class="button secondary new-chat-button" type="button" disabled="@(!Session.IsInitialized || Session.IsBusy)" @onclick="NewChat">@T["Новый чат"]</button>
                </div>
            </div>

            <div class="conversation" @ref="ConversationElement">
                @if (Session.Messages.Count == 0 && string.IsNullOrWhiteSpace(Session.LiveText))
                {
                    <div class="empty-state">
                        <h2>@T["Опишите экран или правку"]</h2>
                        <p>@T["Можно приложить изображение или JSON. Изображения и JSON остаются в истории чата."]</p>
                        <div class="starter-prompts">
                            <button @onclick="PromptSettings">@T["Экран настроек"]</button>
                            <button @onclick="PromptReview">@T["Проверить JSON"]</button>
                        </div>
                    </div>
                }
                @foreach (var message in Session.Messages)
                {
                    <article class="message @(message.Role == "user" ? "user-message" : "assistant-message")">
                        <header class="message-head"><span>@(message.Role == "user" ? T["Вы"] : T["Модель"])</span><time>@(message.Timestamp?.ToLocalTime().ToString("HH:mm") ?? string.Empty)</time></header>
                        @if (!string.IsNullOrWhiteSpace(message.Reasoning))
                        {
                            <details class="reasoning-block"><summary>@T["Подробности"]</summary><div class="markdown-body">@((MarkupString)MarkdownRenderer.ToSafeHtml(message.Reasoning))</div></details>
                        }
                        @if (!string.IsNullOrWhiteSpace(message.Text)) { <div class="markdown-body">@((MarkupString)MarkdownRenderer.ToSafeHtml(message.Text))</div> }
                        @if (message.Attachments.Count > 0)
                        {
                            <div class="message-attachments">
                                @foreach (var attachment in message.Attachments)
                                {
                                    @if (attachment.PreviewDataUrl is not null) { <img src="@attachment.PreviewDataUrl" alt="@attachment.Name" /> }
                                    else { <span class="file-chip">@attachment.Name</span> }
                                }
                            </div>
                        }
                    </article>
                }
                @if (!string.IsNullOrWhiteSpace(Session.LiveText) || !string.IsNullOrWhiteSpace(Session.LiveReasoning))
                {
                    <article class="message assistant-message live-message">
                        <header class="message-head"><span>@T["Модель"]</span><span>@T["Ответ поступает"]</span></header>
                        @if (Session.ShowReasoning && !string.IsNullOrWhiteSpace(Session.LiveReasoning))
                        {
                            <details class="reasoning-block" open><summary>@T["Подробности"]</summary><div class="markdown-body">@((MarkupString)MarkdownRenderer.ToSafeHtml(Session.LiveReasoning))</div></details>
                        }
                        @if (!string.IsNullOrWhiteSpace(Session.LiveText)) { <div class="markdown-body">@((MarkupString)MarkdownRenderer.ToSafeHtml(Session.LiveText))</div> }
                    </article>
                }
                @foreach (var queued in Session.PendingMessages)
                {
                    <article class="message user-message queued-message">
                        <header class="message-head">@T["Вы"] · @(Session.QueuePaused ? "Ожидает продолжения" : T["В очереди"])</header>
                        <div class="markdown-body">@((MarkupString)MarkdownRenderer.ToSafeHtml(queued.Text))</div>
                        @foreach (var image in queued.Attachments) { <img class="queued-image" src="@image.PreviewDataUrl" alt="@image.Name" /> }
                    </article>
                }
            </div>

            @if (DraftAttachments.Count > 0)
            {
                <div class="draft-attachments" aria-label="@T["Вложения"]">
                    @foreach (var attachment in DraftAttachments)
                    {
                        <div class="draft-attachment">
                            @if (attachment.PreviewDataUrl is not null) { <img src="@attachment.PreviewDataUrl" alt="" /> }
                            <span title="@attachment.Name">@attachment.Name</span>
                            <button class="icon-button" type="button" title="@T["Удалить вложение"]" aria-label="@T.Format("Удалить {0}", attachment.Name)" @onclick="() => RemoveAttachment(attachment)">×</button>
                        </div>
                    }
                </div>
            }

            <footer class="composer">
                <div class="composer-tools">
                    <button class="icon-button" type="button" title="@T["Добавить изображение"]" aria-label="@T["Добавить изображение"]" @onclick="PickImage">＋</button>
                    <button class="text-action" type="button" @onclick="PickJson">@T["Прикрепить JSON"]</button>
                    <span class="composer-hint">@T["Enter — отправить · Shift+Enter — новая строка"]</span>
                </div>
                <textarea @bind="DraftText" @bind:event="oninput" @onkeydown="OnComposerKeyDown" rows="3" placeholder="@T["Опишите, что нужно создать или изменить…"]" aria-label="@T["Сообщение"]"></textarea>
                <div class="reasoning-controls" title="@T[Session.ReasoningInfo]">
                    <label>@T["Рассуждения"]
                        <select aria-label="@T["Рассуждения"]" disabled="@Session.LoadingReasoning" value="@ReasoningModeValue" @onchange="ChangeReasoningMode">
                            <option value="">@T["По умолчанию"]</option>
                            <option value="on" disabled="@(!Session.Reasoning.Supported)">@T["Вкл"]</option>
                            <option value="off" disabled="@(!Session.Reasoning.CanDisable)">@T["Выкл"]</option>
                        </select>
                    </label>
                    <label>@T["Уровень"]
                        <select aria-label="@T["Уровень рассуждений"]" value="@ReasoningEffortValue" disabled="@(Session.LoadingReasoning || Session.Reasoning.Efforts.Count == 0 || Session.ReasoningLevel == "off")" @onchange="ChangeReasoningEffort">
                            <option value="">@T["По умолчанию"]</option>
                            @foreach (var effort in Session.Reasoning.Efforts) { <option value="@effort">@effort</option> }
                        </select>
                    </label>
                    <button class="button secondary" disabled="@(!Session.QueuePaused || Session.PendingCount == 0)" @onclick="Session.ResumePending">@T["Продолжить"]</button>
                    <button class="button secondary stop-button" disabled="@(!Session.IsBusy)" @onclick="Session.Cancel">@T["Остановить"]</button>
                </div>
                <div class="usage-line" title="@T["Токены по данным провайдера. Контекст — вход последнего запроса; лимит из каталога модели. Σ — расход с начала запуска приложения."]">
                    <span>↑ @Tokens(Session.Usage?.InputTokens)</span>
                    <span>↓ @Tokens(Session.Usage?.OutputTokens)</span>
                    <span>Σ @Tokens(Session.Usage?.SessionTotalTokens)</span>
                    <span class="context-usage">@T["Контекст"] @Tokens(Session.Usage?.ContextUsedTokens) / @Tokens(Session.Usage?.ContextLimitTokens)</span>
                </div>
                <div class="composer-bottom">
                    <span class="elapsed">@Elapsed.Elapsed.TotalSeconds.ToString("0") @T["с"]</span>
                    <span class="status-copy" title="@Session.Status">@Session.Status @(Session.PendingCount > 0 ? "· " + T.Format("в очереди {0}", Session.PendingCount) : "")</span>
                    <details class="error-details @(!string.IsNullOrWhiteSpace((LocalError ?? Session.LastError)) ? "has-error" : "")">
                        <summary title="@T["Подробности состояния"]" aria-label="@T["Подробности состояния"]">ⓘ</summary>
                        <p>@(T[(LocalError ?? Session.LastError) ?? "Ошибок нет. "] + (LocalError is null && Session.LastError is null ? Session.Status : ""))</p>
                    </details>

                    <button class="button primary send-button" type="button" disabled="@(string.IsNullOrWhiteSpace(DraftText) && DraftAttachments.Count == 0)" @onclick="Send">@(Session.IsBusy ? T["В очередь"] : T["Отправить"])</button>
                </div>

            </footer>
        </section>

        <div class="pane-splitter" @ref="SplitterElement" role="separator" tabindex="0" aria-orientation="vertical" aria-label="@T["Ширина панелей"]" title="@T["Ширина панелей"]" aria-valuemin="25" aria-valuemax="75" aria-valuenow="@PaneRatio.ToString(System.Globalization.CultureInfo.InvariantCulture)"></div>
        <aside class="preview-pane @(PreviewExpanded ? "preview-expanded" : "")" aria-label="@T["Предпросмотр LVGL"]">
            <header class="pane-heading right-pane-heading">
                <div class="right-pane-tabs" role="tablist" aria-label="@T["Предпросмотр LVGL"]">
                    <button id="preview-tab" type="button" role="tab" aria-controls="preview-content" aria-selected="@(!ShowSessionLog ? "true" : "false")" @onclick="() => SelectRightTab(false)">@T["Предпросмотр LVGL"]</button>
                    <button id="session-log-tab" type="button" role="tab" aria-controls="session-log" aria-selected="@(ShowSessionLog ? "true" : "false")" @onclick="() => SelectRightTab(true)">@T["События сессии"] <span class="activity-count">@Session.Logs.Count</span></button>
                </div>
                <div class="preview-actions"><button class="icon-button" type="button" title="@RightPaneExpandLabel" aria-label="@RightPaneExpandLabel" aria-pressed="@(PreviewExpanded ? "true" : "false")" @onclick="() => PreviewExpanded = !PreviewExpanded">@(PreviewExpanded ? "×" : "⛶")</button>
                <button class="icon-button copy-frame-button" type="button" title="@T["Копировать экран в буфер"]" aria-label="@T["Копировать экран в буфер"]" disabled="@(ShowSessionLog || !Session.HasFreshPreview)" @onclick="CopyPreview"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="13" rx="1.5"/><path d="M16 8V3H3v13h5"/></svg></button>
                <button class="icon-button refresh-button" type="button" title="@T["Обновить кадр"]" aria-label="@T["Обновить кадр"]" disabled="@(ShowSessionLog || !Session.IsConnected)" @onclick="RefreshPreview">↻</button></div>
            </header>

            <div id="preview-content" class="preview-content" role="tabpanel" aria-labelledby="preview-tab" hidden="@ShowSessionLog">
                <div class="layout-debug-inline" aria-label="@T["Настройки диагностики разметки"]">
                    <div class="preview-options">
                        <div class="preview-transfer-row">
                            <label class="preview-input-toggle" title="@T["Управлять экраном"]"><input type="checkbox" checked="@Session.PreviewPointerEnabled" disabled="@(!Session.PreviewPointerOptionAvailable)" @onchange="TogglePreviewPointer" />@T["Управлять"]</label>
                            @if (Session.PreviewWebSocketRequired)
                            {
                                <span class="preview-active-transport">@T.Format("Используется {0}", "WS")</span>
                            }
                            else if (Session.PreviewWebSocketAvailable)
                            {
                                <div class="preview-transport" role="group" aria-label="@T["Транспорт кадра"]">
                                    <button type="button" aria-pressed="@(!Session.PreviewWebSocket ? "true" : "false")" @onclick="() => Session.SetPreviewWebSocket(false)">HTTP</button>
                                    <button type="button" aria-pressed="@(Session.PreviewWebSocket ? "true" : "false")" @onclick="() => Session.SetPreviewWebSocket(true)">WS</button>
                                </div>
                                <span class="preview-active-transport">@T.Format("Используется {0}", Session.PreviewWebSocket ? "WS" : "HTTP")</span>
                            }
                        </div>
                        <div class="preview-transfer-row">
                            <label class="preview-progressive-toggle" title="@T["Показывать кадр по мере загрузки"]"><input type="checkbox" checked="@Session.ProgressivePreview" disabled="@(!Session.ProgressivePreviewAvailable)" @onchange="ToggleProgressivePreview" />@T["Постепенно"]</label>
                            <div class="preview-transfer-progress" title="@T["Распакованные байты обновления"]">
                                <span class="preview-byte-progress">@(Session.ProgressivePreviewTotal > 0 ? $"{Session.ProgressivePreviewTotal:N0}" : "—")</span>
                                <span class="preview-byte-progress">@(Session.ProgressivePreviewTotal > 0 ? $"{Session.ProgressivePreviewReceived:N0}" : "—")</span>
                                <progress aria-label="@T["Загрузка кадра"]" max="@Math.Max(1, Session.ProgressivePreviewTotal)" value="@Session.ProgressivePreviewReceived"></progress>
                            </div>
                        </div>
                    </div>
                    <div class="debug-level-scroll">
                        <table class="debug-level-table" aria-label="@T["Диагностика разметки"]">
                            <thead><tr><th scope="col">@T["Слой"]</th>
                            @for (var depth = 0; depth < (Session.LayoutDebug?.Levels.Length ?? 0); depth++)
                            { <th scope="col">@depth</th> }
                            </tr></thead>
                            <tbody>
                            @for (var rowIndex = 0; rowIndex < 4; rowIndex++)
                            {
                                var row = rowIndex;
                                <tr><th scope="row">@T[DebugRowName(row)]</th>
                                @for (var index = 0; index < (Session.LayoutDebug?.Levels.Length ?? 0); index++)
                                {
                                    var depth = index;
                                    var level = Session.LayoutDebug!.Levels[depth];
                                    var fill = row >= 2;
                                    <td>
                                    @if (row == 0 || row == 3)
                                    {
                                        <input type="checkbox" aria-label="@T.Format("{0}: слой {1}", T[DebugRowName(row)], depth)" @bind:get="@(fill ? level.Digit : level.Outline)" @bind:set="(bool enabled) => ChangeDebugLevel(depth, fill, enabled)" disabled="@DebugUnavailable" />
                                    }
                                    else
                                    {
                                        <input class="debug-level-color" type="color" aria-label="@T.Format("{0}: слой {1}", T[DebugRowName(row)], depth)" title="@T.Format("{0}: слой {1}", T[DebugRowName(row)], depth)" value="@ColorHex(fill ? level.DigitColor : level.OutlineColor)" @onchange="(ChangeEventArgs e) => ChangeDebugColor(depth, fill, e.Value?.ToString())" disabled="@DebugUnavailable" />
                                    }
                                    </td>
                                }
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <div class="debug-shared-options">
                        <label class="debug-type" title="@T["G — Grid, F — Flex; выключено — номер слоя"]"><input type="checkbox" aria-label="G/F" @bind:get="@(Session.LayoutDebug?.LayoutType ?? false)" @bind:set="ChangeDebugType" disabled="@DebugUnavailable" />G/F</label>
                        <label title="@T["Толщина рамки"]"><input type="number" aria-label="@T["Толщина рамки"]" min="1" max="16" @bind:get="@(Session.LayoutDebug?.OutlineWidth ?? 3)" @bind:set="ChangeOutlineWidth" disabled="@DebugUnavailable" />px</label>
                        <label class="debug-opacity" title="@T["Непрозрачность фона"]">α<input type="range" aria-label="@T["Непрозрачность фона"]" min="0" max="255" @bind:get="@(Session.LayoutDebug?.Opacity ?? 192)" @bind:set="ChangeDebugOpacity" disabled="@DebugUnavailable" /><span>@((Session.LayoutDebug?.Opacity ?? 192) * 100 / 255)%</span></label>
                    </div>
                </div>
                <div @ref="PreviewStageElement" class="preview-stage @(Session.CanSendPreviewPointer ? "preview-pointer-enabled" : null)">
                    @if (Session.ProgressivePreviewAvailable) { <canvas @ref="PreviewImageElement" class="preview-image" aria-label="@T["Последний фактический кадр LVGL"]"></canvas> }
                    else if (!string.IsNullOrWhiteSpace(Session.PreviewDataUrl)) { <img class="preview-image" src="@Session.PreviewDataUrl" alt="@T["Последний фактический кадр LVGL"]" draggable="false" /> }
                    else { <div class="preview-empty"><span class="preview-glyph" aria-hidden="true">▦</span><span>@T["Кадр ещё не получен"]</span></div> }
                </div>
                @if (!string.IsNullOrWhiteSpace(Session.PreviewDescription)) { <p class="preview-meta">@Session.PreviewDescription</p> }
            </div>
            <div id="session-log" class="activity-list" role="tabpanel" aria-labelledby="session-log-tab" tabindex="0" hidden="@(!ShowSessionLog)">
                @if (ShowSessionLog)
                {
                    @foreach (var entry in Session.Logs.Reverse())
                    {
                        <div class="activity-row"><time>@entry.At.ToLocalTime().ToString("HH:mm:ss")</time><span class="activity-kind">@entry.Kind</span><span>@entry.Text</span></div>
                    }
                    @if (Session.Logs.Count == 0)
                    {
                        <p class="activity-empty">@T["Журнал пока пуст"]</p>
                    }
                }
            </div>
        </aside>
    </main>
</div>
@if (SettingsOpen)
{
    <SettingsPanel Settings="Session.Settings" OnSaveModel="SaveModelSettings" OnSaveConnections="SaveConnectionSettings" OnTabChanged="ClearSettingsNotice" OnLanguageChanged="SetLanguage" SavedNotice="@SettingsNotice" OnClose="CloseSettings" OnLoadModels="LoadModels" Models="Models" LoadingModels="LoadingModels" Error="@SettingsError" />
}
</div>

@code {
    private ElementReference ConversationElement, WorkAreaElement, SplitterElement;
    private double PaneRatio = Preferences.Default.Get("nacborui.designer.chat-width", 62.0);
    private string PaneStyle => $"--chat-track:{PaneRatio.ToString(System.Globalization.CultureInfo.InvariantCulture)}fr;--preview-track:{(100 - PaneRatio).ToString(System.Globalization.CultureInfo.InvariantCulture)}fr";
    private static string DebugRowName(int row) => row switch { 0 => "Рамка", 1 => "RGB рамки", 2 => "RGB фона", _ => "Фон" };
    private void SetLanguage(string language) => T.SetLanguage(language);
    [JSInvokable]
    public Task SavePaneRatio(double ratio) => InvokeAsync(() =>
    {
        PaneRatio = Math.Clamp(ratio, 25, 75);
        Preferences.Default.Set("nacborui.designer.chat-width", PaneRatio);
        StateHasChanged();
    });
    private readonly System.Diagnostics.Stopwatch Elapsed = new();
    private System.Threading.Timer? Clock;
    private string? LocalError;
    private string DraftText { get; set; } = string.Empty;
    private List<DraftFile> DraftAttachments { get; } = new();
    private bool PreviewExpanded;
    private bool ShowSessionLog;
    private string RightPaneExpandLabel => PreviewExpanded ? T["Свернуть панель"] : T["Развернуть панель"];

    private async Task SelectRightTab(bool showLog)
    {
        if (ShowSessionLog == showLog) return;
        if (showLog) await UnbindPreviewPointerAsync();
        ShowSessionLog = showLog;
    }
    private bool SettingsOpen { get; set; }
    private bool DarkTheme { get; set; }
    private bool LoadingModels { get; set; }
    private string? SettingsError { get; set; }
    private string? SettingsNotice { get; set; }
    private IReadOnlyList<string> Models { get; set; } = Array.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += HandleSessionChanged;
        Session.ProgressivePreviewRequested += HandleProgressivePreviewRequested;
        Clock = new System.Threading.Timer(_ => { if (Session.IsBusy) _ = InvokeAsync(StateHasChanged); }, null, 1000, 1000);
        DarkTheme = Preferences.Default.Get("nacborui.designer.dark-theme", false);
        await Session.InitializeAsync();
    }

    private DotNetObjectReference<Home>? PasteReference;
    private ElementReference PreviewImageElement;
    private ElementReference PreviewStageElement;
    private ElementReference BoundProgressiveCanvasElement;
    private bool PreviewPointerBound;
    private bool ProgressiveRefreshPending;
    private int LastProgressiveResetVersion = -1;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Session.InitializeBrowserToolsAsync(action => InvokeAsync(action));
            PasteReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("designerUi.bindPaste", PasteReference);
            await JS.InvokeVoidAsync("designerUi.bindSplitter", WorkAreaElement, SplitterElement, PasteReference);
        }
        await UpdatePreviewPointerBindingAsync();
        if (LastProgressiveResetVersion != Session.ProgressivePreviewResetVersion)
        {
            LastProgressiveResetVersion = Session.ProgressivePreviewResetVersion;
            try { await JS.InvokeVoidAsync("designerUi.clearProgressiveFrame", BoundProgressiveCanvasElement); }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException) { }
            try { await JS.InvokeVoidAsync("designerUi.clearProgressiveFrame", PreviewImageElement); }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException) { }
            BoundProgressiveCanvasElement = default;
        }
        if (ProgressiveRefreshPending && Session.ProgressivePreviewAvailable && PasteReference is not null)
        {
            ProgressiveRefreshPending = false;
            _ = JS.InvokeVoidAsync("designerUi.requestProgressiveFrame", PreviewImageElement, PasteReference,
                Session.ProgressivePreview, Session.ProgressivePreviewResetVersion, Session.PreviewPointerConnectionId, Session.PreviewWebSocket);
            BoundProgressiveCanvasElement = PreviewImageElement;
        }
        await JS.InvokeVoidAsync("designerUi.followChat", false);
    }

    private async Task UpdatePreviewPointerBindingAsync()
    {
        var canBind = !ShowSessionLog && Session.PreviewPointerOptionAvailable && PasteReference is not null;
        if (!canBind)
        {
            await UnbindPreviewPointerAsync();
            return;
        }

        var connectionId = Session.PreviewPointerConnectionId;
        try
        {
            await JS.InvokeVoidAsync("designerUi.bindPreviewPointer", PreviewStageElement, PasteReference,
                Session.PreviewOriginalWidth, Session.PreviewOriginalHeight, Session.CanSendPreviewPointer, connectionId);
            PreviewPointerBound = true;
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException) { }
    }

    private async Task UnbindPreviewPointerAsync()
    {
        if (!PreviewPointerBound) return;
        try { await JS.InvokeVoidAsync("designerUi.unbindPreviewPointer", PreviewStageElement); }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException) { }
        PreviewPointerBound = false;
    }

    private void TogglePreviewPointer(ChangeEventArgs args) =>
        Session.SetPreviewPointerEnabled(args.Value is bool enabled && enabled);

    private void ToggleProgressivePreview(ChangeEventArgs args) =>
        Session.SetProgressivePreviewEnabled(args.Value is bool enabled && enabled);

    private void HandleProgressivePreviewRequested()
    {
