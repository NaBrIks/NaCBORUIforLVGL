    private async Task PickImageCore()
    {
        var file = await FilePicker.Default.PickAsync(new PickOptions { PickerTitle = T["Выберите изображение"], FileTypes = FilePickerFileType.Images });
        if (file is not null) await AddFile(file, 8 * 1024 * 1024);
    }

    private async Task PickJsonCore()
    {
        var types = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
        {
            [DevicePlatform.WinUI] = new[] { ".json" },
            [DevicePlatform.Android] = new[] { "application/json", "text/json" }
        });
        var file = await FilePicker.Default.PickAsync(new PickOptions { PickerTitle = T["Выберите JSON"], FileTypes = types });
        if (file is not null) await AddFile(file, 512 * 1024);
    }

    private async Task AddFile(FileResult file, int maxBytes)
    {
        if (DraftAttachments.Count >= 8) throw new InvalidOperationException(T["Не более 8 вложений в одном сообщении."]);
        if (DraftAttachments.Any(item => item.Name.Equals(file.FileName, StringComparison.OrdinalIgnoreCase))) return;
        await using var input = await file.OpenReadAsync();
        using var memory = new MemoryStream();
        var buffer = new byte[16 * 1024];
        int read;
        while ((read = await input.ReadAsync(buffer)) > 0)
        {
            if (memory.Length + read > maxBytes) throw new InvalidOperationException(T.Format("Файл больше допустимого предела {0} КБ.", maxBytes / 1024));
            await memory.WriteAsync(buffer.AsMemory(0, read));
        }
        var bytes = memory.ToArray();
        if (file.FileName.EndsWith(".json", StringComparison.OrdinalIgnoreCase))
        {
            var content = System.Text.Encoding.UTF8.GetString(bytes);
            using var _ = System.Text.Json.JsonDocument.Parse(content);
            DraftAttachments.Add(new DraftFile(file.FileName, "application/json", null, content));
        }
        else
        {
            var mime = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType;
            if (!mime.StartsWith("image/", StringComparison.OrdinalIgnoreCase)) throw new InvalidOperationException(T["Поддерживаются только изображения и JSON."]);
            DraftAttachments.Add(new DraftFile(file.FileName, mime, $"data:{mime};base64,{Convert.ToBase64String(bytes)}", null));
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnComposerKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !args.ShiftKey) await Send();
    }

    public async ValueTask DisposeAsync()
    {
        await UnbindPreviewPointerAsync();
        try { await JS.InvokeVoidAsync("designerUi.clearProgressiveFrame", BoundProgressiveCanvasElement); }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException) { }
        try { await JS.InvokeVoidAsync("designerUi.unbindSplitter", SplitterElement); }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException) { }
        PasteReference?.Dispose();
        Clock?.Dispose();
        Session.Changed -= HandleSessionChanged;
        Session.ProgressivePreviewRequested -= HandleProgressivePreviewRequested;
        foreach (var file in DraftAttachments) file.Dispose();
    }

    private sealed class DraftFile(string name, string mimeType, string? dataUrl, string? textContent) : IDisposable
    {
        public string Name { get; } = name;
        public string MimeType { get; } = mimeType;
        public string? DataUrl { get; } = dataUrl;
        public string? TextContent { get; } = textContent;
        public string? PreviewDataUrl => DataUrl;
        public void Dispose() { }
    }
