    [JSInvokable]
    public Task PasteImage(string name, string mime, string dataUrl) => InvokeAsync(() =>
    {
        try
        {
            LocalError = null;
            if (DraftAttachments.Count >= 8) throw new InvalidOperationException(T["Не более 8 вложений."]);
            if (dataUrl.Length > 11200000 || !mime.StartsWith("image/", StringComparison.OrdinalIgnoreCase) ||
                !dataUrl.StartsWith($"data:{mime};base64,", StringComparison.Ordinal))
                throw new InvalidOperationException(T["Некорректное изображение буфера."]);
            var bytes = Convert.FromBase64String(dataUrl[(dataUrl.IndexOf(',') + 1)..]);
            if (bytes.Length > 8 * 1024 * 1024) throw new InvalidOperationException(T["Изображение больше 8 МБ."]);
            DraftAttachments.Add(new DraftFile(name, mime, dataUrl, null));
        }
        catch (Exception ex) { LocalError = ex.Message; }
        StateHasChanged();
    });

    [JSInvokable]
    public Task PasteError(string message) => InvokeAsync(() => { LocalError = T[message]; StateHasChanged(); });

    private void HandleSessionChanged()
    {
        if (Session.IsBusy && !Elapsed.IsRunning) Elapsed.Restart();
        else if (!Session.IsBusy) Elapsed.Stop();
        _ = InvokeAsync(StateHasChanged);
    }
