    private async Task Send()
    {

        LocalError = null;
        if (!Session.IsConnected || string.IsNullOrWhiteSpace(Session.Settings.Model))
        {
            LocalError = T["Подключите устройство и выберите модель в настройках. Введённый запрос сохранён."];
            return;
        }
        if (Session.IsBusy && Session.QueuePaused) { LocalError = T["Дождитесь завершения остановки. Запрос сохранён."]; return; }
        var text = DraftText.Trim();
        var imageInputs = new List<SPLA.Domain.Models.ImageAttachment>();
        foreach (var file in DraftAttachments)
        {
            if (file.MimeType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
                imageInputs.Add(new SPLA.Domain.Models.ImageAttachment(file.DataUrl!, file.Name));
            else if (file.TextContent is not null)
                text += Environment.NewLine + Environment.NewLine + "Attached JSON file " + file.Name + ":" + Environment.NewLine + "```json" + Environment.NewLine + file.TextContent + Environment.NewLine + "```";
        }
        try { Session.ValidateEnqueue(imageInputs); }
        catch (Exception ex) { LocalError = ex.Message; return; }
        DraftText = string.Empty;
        DraftAttachments.Clear();
        await JS.InvokeVoidAsync("designerUi.followChat", true);
        await Session.SendAsync(text, imageInputs);
    }

