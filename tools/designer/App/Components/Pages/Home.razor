    private bool Connecting;
    private bool ConnectionLocked => Connecting || Session.IsBusy || Session.PendingCount > 0;
    private string ConnectionLabel => Connecting ? T["Подключение…"] :
        Session.IsConnected ? T["Подключено"] : Session.NeedsReconnect ? T["Переподключить"] : T["Подключить"];
    private string ConnectionTooltip => Connecting ? ConnectionLabel :
        $"{(Session.IsConnected || Session.NeedsReconnect ? T["Переподключить"] : T["Подключить"])} · {Session.Status}";

    private async Task Connect()
    {
        if (ConnectionLocked) return;
        Connecting = true;
        try
        {
            // Release the pointer before the adapter invalidates the old target ID.
            await UnbindPreviewPointerAsync();
            await ClearProgressiveFrameAsync();
            await Session.ConnectAsync();
            if (Session.IsConnected) await Session.RefreshPreviewAsync();
        }
        finally { Connecting = false; }
    }
