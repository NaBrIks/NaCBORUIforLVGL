{
  "name": "nacboruiforlvgl-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "packages/style-codec",
    "packages/screen-codec",
    "packages/document-io",
    "packages/project-codec",
    "packages/css-codec"
  ],
  "scripts": {
    "contract": "node tools/style_contract.mjs && node tools/screen_contract.mjs && node tools/binding_contract.mjs && node tools/composition_contract.mjs && node tools/capabilities.mjs && node tools/assistant_reference.mjs",
    "build": "npm run build --workspace @lvgl-cbor/playground",
    "test": "node --test tests/*.test.mjs",
    "dev": "npm run build && node examples/windows_player/run.mjs --api",
    "sim": "npm run dev",
    "player": "node examples/windows_player/run.mjs --api",
    "player:build": "powershell -NoProfile -File examples/windows_player/build.ps1",
    "player:test": "node examples/windows_player/test-window.mjs",
    "player:test-system": "node examples/windows_player/test-system.mjs",
    "player:test-resize": "node examples/windows_player/test-resize.mjs",
    "contract:check": "node tools/style_contract.mjs --check && node tools/screen_contract.mjs --check && node tools/binding_contract.mjs --check && node tools/composition_contract.mjs --check && node tools/capabilities.mjs --check && node tools/assistant_reference.mjs --check",
    "player:test-catalog": "node examples/windows_player/test-catalog.mjs",
    "player:test-api": "node examples/windows_player/test-api.mjs",
    "player:graphics": "node examples/windows_player/run.mjs --profile graphics --api",
    "player:test-graphics": "node examples/windows_player/test-graphics.mjs",
    "player:test-native-view": "node examples/windows_player/test-native-view.mjs",
    "player:test-assistant": "node examples/windows_player/test-assistant.mjs",
    "player:test-host-settings": "node examples/windows_player/test-host-settings.mjs",
    "player:test-base-migration": "node examples/windows_player/test-base-migration.mjs"
  },
  "license": "MIT",
  "description": "CBOR-based UI definitions for LVGL"
}
